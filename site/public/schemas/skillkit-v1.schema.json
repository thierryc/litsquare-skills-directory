{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.litsquare.com/schemas/skillkit/v1/schema.json",
  "title": "LitSquare SkillKit manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "name", "version", "description", "license", "skills", "dependencies"],
  "properties": {
    "$schema": { "const": "https://skills.litsquare.com/schemas/skillkit/v1/schema.json" },
    "schema_version": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1, "maxLength": 64 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "license": { "type": "string", "minLength": 1, "maxLength": 256 },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^\\./skills/[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "dependencies": { "type": "object", "maxProperties": 0, "additionalProperties": false },
    "metadata": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9._/-]+$" },
      "additionalProperties": { "type": "string" }
    }
  }
}
