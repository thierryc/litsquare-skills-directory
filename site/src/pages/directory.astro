---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Directory — LitSquare Skills" description="Browse portable Skills and Kits from their original publishers.">
  <section class="subhero page-shell">
    <p class="section-label">Public directory</p>
    <h1>Useful Skills, with their source still attached.</h1>
    <p class="lede">Listings retain publisher, license, version claim, digest, and validation date. A listing is provenance—not a claim that instructions are safe.</p>
  </section>
  <section class="directory-state page-shell" aria-labelledby="directory-status">
    <div class="empty-mark" aria-hidden="true">⌕</div>
    <h2 id="directory-status">The first listings are being prepared.</h2>
    <p>The M0–M2 release is focused on the local library. Catalog contributions and verified publisher discovery arrive with M4.</p>
    <div class="hero-actions">
      <a class="button primary" href="https://github.com/thierryc/litsquare-skills-directory/issues/new/choose">Suggest a Skill or Kit</a>
      <a class="button secondary" href="https://github.com/thierryc/litsquare-skills-directory/blob/main/docs/publishing.md">Publishing guide</a>
    </div>
  </section>
</BaseLayout>
