{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.litsquare.com/schemas/catalog/v1/schema.json",
  "title": "LitSquare Skills catalog record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "id", "kind", "name", "description", "publisher", "source", "license", "digest"],
  "properties": {
    "$schema": { "const": "https://skills.litsquare.com/schemas/catalog/v1/schema.json" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 160 },
    "kind": { "enum": ["publisher", "skill", "kit"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "domain"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "domain": { "type": "string", "format": "hostname" }
      }
    },
    "source": { "type": "string", "format": "uri", "pattern": "^https://" },
    "license": { "type": "string", "minLength": 1, "maxLength": 256 },
    "version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "review_status": { "enum": ["submitted", "validated", "first-party"] },
    "last_validated": { "type": "string", "format": "date-time" },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https://" }
  }
}
